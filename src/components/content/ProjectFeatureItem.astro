---
const { project } = Astro.props;
---

<article class="featured-case-study__item js-reveal" role="listitem">
  <figure class="featured-case-study__visual">
    <img src={project.image} alt={`${project.title} project preview`} loading="lazy" decoding="async" />
  </figure>
  <div class="featured-case-study__content">
    <p class="featured-case-study__category">{project.category}</p>
    <h3 class="featured-case-study__project-title">{project.title}</h3>
    <p class="featured-case-study__description">{project.description}</p>
    <a class="featured-case-study__link" href="/work">View Case Study <span aria-hidden="true">→</span></a>
  </div>
</article>
