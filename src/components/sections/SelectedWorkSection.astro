---
import ProjectCard from '../content/ProjectCard.astro';
import { projects } from '../../data/projects';
import '../../styles/selected-work.css';

const featuredProject = projects.find((project) => project.featured);
const displayedProjects = featuredProject ? projects.filter((project) => project.slug !== featuredProject.slug && project.slug !== 'dogus-yayin-grubu') : projects.filter((project) => project.slug !== 'dogus-yayin-grubu');
---

<section class="selected-work" aria-labelledby="selected-work-title">
  <div class="selected-work__inner">
    <div class="selected-work__intro">
      <p class="selected-work__eyebrow">Selected work</p>
      <h2 id="selected-work-title" class="selected-work__title">A focused body of work shaped by clarity, craft, and long-term thinking.</h2>
    </div>

    <div class="selected-work__list">
      {displayedProjects.map((project, index) => (
        <ProjectCard
          title={project.title}
          slug={project.slug}
          category={project.category}
          description={project.description}
          meta={project.meta}
          tone={project.tone}
          index={index}
          year={project.year}
          client={project.client}
          role={project.role}
          image={project.image}
        />
      ))}
    </div>
  </div>
</section>
