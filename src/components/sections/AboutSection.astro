---
import '../../styles/about.css';
---

<section class="about" aria-labelledby="about-title">
  <div class="about__layout">
    <div class="about__content">
      <p class="about__eyebrow">About</p>
      <h2 id="about-title" class="about__title">I shape brands and digital experiences with discipline, clarity, and a precise visual point of view.</h2>
      <p class="about__text">
        I’m Ilknur Demir. I work across brand identity, art direction, digital experience, and UI design. The work is driven by structure, detail, and a long view of the audience.
      </p>
      <p class="about__text about__text--secondary">
        My experience includes work for Penti MyBra, PuhuTV, Vodafone, Bosch, Nesquik, NTV Digital, and Doğuş Yayın Grubu.
      </p>
    </div>

    <div class="about__details" aria-label="Professional overview">
      <div class="about__detail-block">
        <p class="about__detail-label">Experience</p>
        <p class="about__detail-value">10+ years</p>
      </div>
      <div class="about__detail-block">
        <p class="about__detail-label">Focus</p>
        <p class="about__detail-value">Brand · Digital · UI</p>
      </div>
      <div class="about__detail-block">
        <p class="about__detail-label">Approach</p>
        <p class="about__detail-value">Quietly rigorous, carefully considered</p>
      </div>
    </div>
  </div>
</section>
