---
import '../../styles/hero.css';
---

<section class="hero" aria-labelledby="hero-title">
  <div class="hero__layout">
    <div class="hero__content">
      <p class="hero__eyebrow">ART DIRECTOR · BRAND IDENTITY · DIGITAL EXPERIENCE</p>
      <h1 id="hero-title" class="hero__headline">Designing identities, digital experiences, and systems with clarity and intent.</h1>
      <p class="hero__intro">
        I’m Ilknur Demir. I work across art direction, brand identity, digital experience, and UI design. The work is shaped through careful thinking and clear execution.
      </p>
      <div class="hero__actions">
        <a class="hero__cta hero__cta--primary" href="/work">View Projects</a>
        <a class="hero__cta" href="/about">About Me</a>
      </div>
      <p class="hero__meta">Based in Istanbul · Available Worldwide</p>
    </div>

    <aside class="hero__panel" aria-label="Practice overview">
      <div class="hero__panel-mark">Selected focus</div>
      <div class="hero__panel-copy">
        <strong>Brand identity</strong>
        <span>Strategy, systems, expression</span>
      </div>
      <div class="hero__panel-line"></div>
      <div class="hero__panel-copy">
        <strong>Digital experience</strong>
        <span>Interfaces, journeys, storytelling</span>
      </div>
      <div class="hero__panel-line"></div>
      <div class="hero__panel-copy">
        <strong>Creative direction</strong>
        <span>Art direction, collaboration, launch</span>
      </div>
    </aside>
  </div>
</section>
