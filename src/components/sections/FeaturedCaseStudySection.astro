---
import '../../styles/featured-case-study.css';
import ProjectFeatureItem from '../content/ProjectFeatureItem.astro';
import { projects } from '../../data/projects';

const displayedFeaturedProjects = projects.filter((project) => project.featured);
---

<section class="featured-case-study" aria-labelledby="featured-case-study-title">
  <div class="featured-case-study__inner">
    <div class="featured-case-study__intro">
      <p class="featured-case-study__eyebrow">Featured case studies</p>
      <h2 id="featured-case-study-title" class="featured-case-study__title">Selected work presented as clear, considered editorial stories.</h2>
    </div>

    <div class="featured-case-study__list" role="list">
      {displayedFeaturedProjects.map((project) => (
        <ProjectFeatureItem project={project} />
      ))}
    </div>

    <hr class="featured-case-study__divider" />
  </div>
</section>
