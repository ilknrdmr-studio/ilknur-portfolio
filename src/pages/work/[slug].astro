---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageShell from '../../components/layout/PageShell.astro';
import '../../styles/case-study.css';

export async function getStaticPaths() {
  return [
    { params: { slug: 'penti-mybra' } },
    { params: { slug: 'puhutv' } },
    { params: { slug: 'dogus-yayin-grubu' } }
  ];
}

const { slug } = Astro.params;
const isPenti = slug === 'penti-mybra';
---

<BaseLayout>
  <PageShell>
    <article class="case-study">
      {isPenti ? (
        <section class="case-study__hero case-study__hero--single">
          <div class="case-study__hero-copy">
            <h1>Penti MyBra</h1>
            <p class="case-study__subtitle">Finding the perfect bra through a personalized digital experience.</p>
            <div class="case-study__intro">
              <p>MyBra was designed to make a highly personal purchase feel more informed, reassuring, and effortless. The experience combined thoughtful storytelling with a refined interface to guide each decision with clarity.</p>
              <p>The project focused on turning product discovery into a calm and confidence-building journey, where fit, guidance, and emotional reassurance worked in harmony.</p>
              <p>By shaping the experience around the user’s needs rather than the product alone, the brand was able to create a more intimate and memorable retail moment.</p>
            </div>
          </div>

          <div class="case-study__meta case-study__meta--hero">
            <div class="case-study__meta-item">
              <span>Client</span>
              <p>Penti</p>
            </div>
            <div class="case-study__meta-item">
              <span>Role</span>
              <p>Art Direction · Brand Identity · UX/UI Design</p>
            </div>
            <div class="case-study__meta-item">
              <span>Year</span>
              <p>2018</p>
            </div>
            <div class="case-study__meta-item">
              <span>Industry</span>
              <p>Fashion Retail</p>
            </div>
          </div>

          <div class="case-study__visual case-study__visual--hero"></div>
        </section>

        <section class="case-study__section case-study__challenge" aria-labelledby="challenge-title">
          <p class="case-study__challenge-label">Challenge</p>
          <h2 id="challenge-title">Challenge</h2>
          <div class="case-study__challenge-copy">
            <!-- Challenge copy will be inserted here -->
          </div>
          <div class="case-study__visual case-study__visual--challenge" aria-label="Challenge image placeholder"></div>
        </section>

        <section class="case-study__section case-study__objectives" aria-labelledby="objectives-title">
          <p class="case-study__challenge-label">Objectives</p>
          <h2 id="objectives-title">Turning uncertainty into a guided and confident experience.</h2>
          <div class="case-study__objectives-grid">
            <div class="case-study__objective">
              <h3>Simplify the decision</h3>
              <div class="case-study__objective-copy">
                <!-- Objective copy will be inserted here -->
              </div>
            </div>
            <div class="case-study__objective">
              <h3>Build confidence</h3>
              <div class="case-study__objective-copy">
                <!-- Objective copy will be inserted here -->
              </div>
            </div>
            <div class="case-study__objective">
              <h3>Create consistency</h3>
              <div class="case-study__objective-copy">
                <!-- Objective copy will be inserted here -->
              </div>
            </div>
          </div>
        </section>

        <section class="case-study__section case-study__creative-direction" aria-labelledby="creative-direction-title">
          <p class="case-study__challenge-label">Creative Direction</p>
          <h2 id="creative-direction-title">Designing clarity through simplicity.</h2>
          <div class="case-study__creative-layout">
            <div class="case-study__creative-copy">
              <!-- Creative direction copy will be inserted here -->
            </div>
            <div class="case-study__creative-cards">
              <div class="case-study__creative-card">
                <h3>Visual Language</h3>
                <div class="case-study__creative-card-copy">
                  <!-- Content will be inserted here -->
                </div>
              </div>
              <div class="case-study__creative-card">
                <h3>Typography</h3>
                <div class="case-study__creative-card-copy">
                  <!-- Content will be inserted here -->
                </div>
              </div>
              <div class="case-study__creative-card">
                <h3>Color System</h3>
                <div class="case-study__creative-card-copy">
                  <!-- Content will be inserted here -->
                </div>
              </div>
            </div>
          </div>
          <div class="case-study__visual case-study__visual--landscape" aria-label="Creative direction image placeholder"></div>
        </section>
      ) : (
        <>
          <section class="case-study__hero">
            <p class="case-study__eyebrow">Case study / {slug}</p>
            <h1>{slug}</h1>
            <p style="margin-top: 1rem; max-width: 42rem;">A brand and digital launch built around clarity, confidence, and a more considered retail experience.</p>

            <div class="case-study__meta">
              <div class="case-study__meta-item">
                <span>Category</span>
                <p>Brand identity · Digital launch</p>
              </div>
              <div class="case-study__meta-item">
                <span>Year</span>
                <p>2024</p>
              </div>
              <div class="case-study__meta-item">
                <span>Client</span>
                <p>Penti MyBra</p>
              </div>
              <div class="case-study__meta-item">
                <span>Role</span>
                <p>Art direction · Brand design</p>
              </div>
            </div>

            <div class="case-study__awards" style="margin-top: 1.75rem; max-width: 24rem;">
              <span>Awards</span>
              <p>Shortlist · Brand Experience, 2024</p>
            </div>
          </section>

<section class="case-study__section" aria-labelledby="project-overview-title">
        <h2 id="project-overview-title">Project Overview</h2>
        <div class="case-study__overview">
          <div class="case-study__overview-copy">
            <!-- Project overview copy will be inserted here -->
          </div>
          <div class="case-study__facts" aria-label="Project facts">
            <div class="case-study__fact">
              <span>Client</span>
              <p>—</p>
            </div>
            <div class="case-study__fact">
              <span>Industry</span>
              <p>—</p>
            </div>
            <div class="case-study__fact">
              <span>Services</span>
              <p>—</p>
            </div>
            <div class="case-study__fact">
              <span>Timeline</span>
              <p>—</p>
            </div>
            <div class="case-study__fact">
              <span>Role</span>
              <p>—</p>
            </div>
            <div class="case-study__fact">
              <span>Team</span>
              <p>—</p>
            </div>
          </div>
        </div>
      </section>

      <div class="case-study__visual case-study__visual--hero" aria-label="Project image placeholder"></div>

          <section class="case-study__section">
            <h2>Strategy</h2>
            <p>The strategy centered on building a brand experience that felt refined, direct, and human. Rather than adding complexity, the visual system was designed to create clarity through restraint, allowing the product and the narrative to lead.</p>
          </section>

          <section class="case-study__section">
            <h2>Brand identity system</h2>
            <p>The identity system brought together a flexible typographic structure, a carefully calibrated color palette, and a set of expressive visual cues. Every layer of the system was designed to support a sense of confidence, softness, and modernity.</p>
          </section>

          <section class="case-study__section">
            <h2>Digital launch</h2>
            <p>The digital launch translated the brand into an experience that felt coherent from first impression to conversion. Messaging, interface hierarchy, and content rhythm were all shaped to support the new positioning and create momentum around the release.</p>
          </section>

          <section class="case-study__section">
            <h2>Design process</h2>
            <div class="case-study__process">
              <div class="case-study__process-item">
                <h3>01 / Insight</h3>
                <p>Mapping the emotional and commercial expectations behind the launch.</p>
              </div>
              <div class="case-study__process-item">
                <h3>02 / System</h3>
                <p>Developing the identity framework and its applications across touchpoints.</p>
              </div>
              <div class="case-study__process-item">
                <h3>03 / Refinement</h3>
                <p>Testing the expression of the system in motion, layout, and digital content.</p>
              </div>
            </div>
          </section>

          <section class="case-study__section">
            <h2>Key visuals</h2>
            <div class="case-study__gallery">
              <div class="case-study__visual"></div>
              <div class="case-study__visual"></div>
            </div>
          </section>

          <section class="case-study__section">
            <h2>Results</h2>
            <p>The work helped establish a more cohesive and premium presence for the brand, giving the launch a stronger point of view and a more lasting impression across both digital and physical contexts.</p>
          </section>

          <section class="case-study__section">
            <h2>Awards</h2>
            <p>Shortlisted for Brand Experience in 2024, with the project recognized for its clarity of narrative and consistency across channels.</p>
          </section>

          <section class="case-study__section">
            <h2>Gallery</h2>
            <div class="case-study__gallery">
              <div class="case-study__visual"></div>
              <div class="case-study__visual"></div>
            </div>
          </section>

          <nav class="case-study__pagination" aria-label="Project navigation">
            <a href="/" aria-label="Back to home">← Previous project</a>
            <a href="/work/puhutv" aria-label="Next project">Next project →</a>
          </nav>
        </>
      )}
    </article>
  </PageShell>
</BaseLayout>
