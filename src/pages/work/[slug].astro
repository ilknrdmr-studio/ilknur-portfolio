            <img src="/images/projects/dyg:/images/09-final experience.jpg" alt="DYG Website final experience" class="case-study__image" />
          </section>

          <section class="case-study__image-section">
            <img src="/images/projects/dyg:/images/10-closing.jpg" alt="DYG Website closing" class="case-study__image" />
          </section>
        </>
      ) : isPuhu ? (
