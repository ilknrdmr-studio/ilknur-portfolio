---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageShell from '../../components/layout/PageShell.astro';
import '../../styles/case-study.css';

export async function getStaticPaths() {
  return [
    { params: { slug: 'penti-mybra' } },
    { params: { slug: 'puhutv' } },
    { params: { slug: 'dogus-yayin-grubu' } }
  ];
}

const { slug } = Astro.params;
const isPenti = slug === 'penti-mybra';
---

<BaseLayout>
  <PageShell>
    <article class="case-study">
      {isPenti ? (
        <>
          <section class="case-study__image-section">
            <img src="/images/projects/penti-mybra:/images/01-hero.jpg" alt="Penti MyBra hero" class="case-study__image" />
          </section>

          <section class="case-study__image-section">
            <img src="/images/projects/penti-mybra:/images/02-overview.jpg" alt="Penti MyBra overview" class="case-study__image" />
          </section>

          <section class="case-study__image-section">
            <img src="/images/projects/penti-mybra:/images/03-challenge.jpg" alt="Penti MyBra challenge" class="case-study__image" />
          </section>

          <section class="case-study__image-section">
            <img src="/images/projects/penti-mybra:/images/04-strategy.jpg" alt="Penti MyBra strategy" class="case-study__image" />
          </section>

          <section class="case-study__image-section">
            <img src="/images/projects/penti-mybra:/images/05-experience-flow.jpg" alt="Penti MyBra experience flow" class="case-study__image" />
          </section>

          <section class="case-study__image-section">
            <img src="/images/projects/penti-mybra:/images/06-design-system.jpg" alt="Penti MyBra design system" class="case-study__image" />
          </section>

          <section class="case-study__image-section">
            <img src="/images/projects/penti-mybra:/images/07-final-interface.jpg" alt="Penti MyBra final interface" class="case-study__image" />
          </section>

          <section class="case-study__image-section">
            <img src="/images/projects/penti-mybra:/images/08-responsive.jpg" alt="Penti MyBra responsive design" class="case-study__image" />
          </section>

          <section class="case-study__image-section">
            <img src="/images/projects/penti-mybra:/images/09-results.jpg" alt="Penti MyBra results" class="case-study__image" />
          </section>

          <section class="case-study__image-section">
            <img src="/images/projects/penti-mybra:/images/10-closing.jpg" alt="Penti MyBra closing" class="case-study__image" />
          </section>
        </>
      ) : (
        <>
          <section class="case-study__image-section">
            <img src="/images/projects/penti-mybra:/images/01-hero.jpg" alt="Penti MyBra hero" class="case-study__image" />
          </section>

          <section class="case-study__image-section">
            <img src="/images/projects/penti-mybra:/images/02-overview.jpg" alt="Penti MyBra overview" class="case-study__image" />
          </section>

          <section class="case-study__image-section">
            <img src="/images/projects/penti-mybra:/images/03-challenge.jpg" alt="Penti MyBra challenge" class="case-study__image" />
          </section>

          <section class="case-study__image-section">
            <img src="/images/projects/penti-mybra:/images/04-strategy.jpg" alt="Penti MyBra strategy" class="case-study__image" />
          </section>

          <section class="case-study__image-section">
            <img src="/images/projects/penti-mybra:/images/05-experience-flow.jpg" alt="Penti MyBra experience flow" class="case-study__image" />
          </section>

          <section class="case-study__image-section">
            <img src="/images/projects/penti-mybra:/images/06-design-system.jpg" alt="Penti MyBra design system" class="case-study__image" />
          </section>

          <section class="case-study__image-section">
            <img src="/images/projects/penti-mybra:/images/07-final-interface.jpg" alt="Penti MyBra final interface" class="case-study__image" />
          </section>

          <section class="case-study__image-section">
            <img src="/images/projects/penti-mybra:/images/08-responsive.jpg" alt="Penti MyBra responsive design" class="case-study__image" />
          </section>

          <section class="case-study__image-section">
            <img src="/images/projects/penti-mybra:/images/09-results.jpg" alt="Penti MyBra results" class="case-study__image" />
          </section>

          <section class="case-study__image-section">
            <img src="/images/projects/penti-mybra:/images/10-closing.jpg" alt="Penti MyBra closing" class="case-study__image" />
          </section>
        </>
      )}
    </article>
  </PageShell>
</BaseLayout>
