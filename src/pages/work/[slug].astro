---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageShell from '../../components/layout/PageShell.astro';
import '../../styles/case-study.css';

export async function getStaticPaths() {
  return [
    { params: { slug: 'penti-mybra' } },
    { params: { slug: 'bosch' } },
    { params: { slug: 'puhutv' } },
    { params: { slug: 'dyg-website' } },
    { params: { slug: 'nesquik' } },
    { params: { slug: 'dogus-yayin-grubu' } }
  ];
}

const { slug } = Astro.params;
const isPenti = slug === 'penti-mybra';
const isBosch = slug === 'bosch';
const isPuhu = slug === 'puhutv';
const isDyg = slug === 'dyg-website';
const isNesquik = slug === 'nesquik';
---

<BaseLayout htmlClass={isBosch ? 'page--bosch' : isPenti ? 'page--penti' : isPuhu ? 'page--puhu' : isDyg ? 'page--dyg' : isNesquik ? 'page--nesquik' : ''} bodyClass={isBosch ? 'body--bosch' : isPenti ? 'body--penti' : isPuhu ? 'body--puhu' : isDyg ? 'body--dyg' : isNesquik ? 'body--nesquik' : ''}>
  <PageShell>
    <article class={`case-study ${isBosch ? 'case-study--bosch' : ''} ${isPenti ? 'case-study--penti' : ''} ${isPuhu ? 'case-study--puhu' : ''} ${isDyg ? 'case-study--dyg' : ''} ${isNesquik ? 'case-study--nesquik' : ''}`}>
      {isPenti ? (
        <>
          <section class="case-study__image-section">
            <img src="/images/projects/penti-mybra:/images/01-hero.jpg" alt="Penti MyBra hero" class="case-study__image" />
          </section>

          <section class="case-study__image-section">
            <img src="/images/projects/penti-mybra:/images/02-overview.jpg" alt="Penti MyBra overview" class="case-study__image" />
